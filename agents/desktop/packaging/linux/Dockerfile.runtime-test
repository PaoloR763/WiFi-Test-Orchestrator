FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /workspace

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
       adduser \
       python3 \
       python3-pydantic \
       python3-venv \
       systemd \
    && rm -rf /var/lib/apt/lists/*

RUN sed -i '\#path-exclude=/usr/share/doc/\*#d' /etc/dpkg/dpkg.cfg.d/excludes

COPY scripts/linux/install-agent.sh scripts/linux/install-agent.sh
COPY scripts/linux/test-deb-runtime.sh scripts/linux/test-deb-runtime.sh
