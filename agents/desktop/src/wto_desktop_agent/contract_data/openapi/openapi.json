  "components": {
    "securitySchemes": {
      "UserBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "UserRefreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "wto_refresh"
      },
      "AgentBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "WTO-AgentCredential-v1"
      },
      "AgentPendingCredentialAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "WTO-PendingAgentCredential-v1"
      }
    },
    "headers": {
      "CorrelationId": {
        "description": "Request correlation identifier",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      }
    },
    "parameters": {
      "UserId": {
        "name": "user_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "RoleKey": {
        "name": "role_key",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 3, "maxLength": 64 }
      },
      "TokenId": {
        "name": "token_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "AgentId": {
        "name": "agent_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "CredentialId": {
        "name": "credential_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "RotationId": {
        "name": "rotation_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "AgentTimestamp": {
        "name": "X-WTO-Agent-Timestamp",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "format": "date-time", "pattern": "Z$" }
      },
      "AgentNonce": {
        "name": "X-WTO-Agent-Nonce",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$" }
      },
      "AgentProtocol": {
        "name": "X-WTO-Agent-Protocol",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "const": "1.0.0" }
      },
      "CorrelationIdRequest": {
        "name": "X-Correlation-ID",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      }
    },
    "schemas": {
      "EnrollmentTokenCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "string",
            "enum": ["agent.enroll", "agent.recover"],
            "default": "agent.enroll"
          },
          "expires_in_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440,
            "default": 15
          },
          "allowed_platforms": {
            "type": "array",
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["simulated", "windows", "linux", "android", "ios"]
            }
          },
          "bound_agent_id": {
            "anyOf": [
              { "type": "string", "format": "uuid" },
              { "type": "null" }
            ]
          }
        }
      },
      "EnrollmentTokenResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "enrollment_token_id",
          "enrollment_token",
          "scope",
          "expires_at",
          "max_uses"
        ],
        "properties": {
          "schema_version": { "type": "string", "const": "1.0.0" },
          "enrollment_token_id": { "type": "string", "format": "uuid" },
          "enrollment_token": {
            "type": "string",
            "minLength": 90,
            "maxLength": 90,
            "pattern": "^wto_enr_1\\.[0-9a-f-]{36}\\.[A-Za-z0-9_-]{43}$",
            "writeOnly": true
          },
          "scope": {
            "type": "string",
            "enum": ["agent.enroll", "agent.recover"]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "max_uses": { "type": "integer", "const": 1 }
        }
      },
      "RotationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "idempotency_key"],
        "properties": {
          "schema_version": { "type": "string", "const": "1.0.0" },
          "idempotency_key": { "type": "string", "format": "uuid" }
        }
      },
      "RotationCreateResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "rotation_id",
          "expires_at",
          "pending_credential"
        ],
        "properties": {
          "schema_version": { "type": "string", "const": "1.0.0" },
          "rotation_id": { "type": "string", "format": "uuid" },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "pending_credential": {
            "$ref": "../schemas/agent-credential.schema.json"
          }
        }
      },
      "RotationActivateResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "rotation_id",
          "credential_id",
          "credential_version",
          "activated_at"
        ],
        "properties": {
          "schema_version": { "type": "string", "const": "1.0.0" },
          "rotation_id": { "type": "string", "format": "uuid" },
          "credential_id": { "type": "string", "format": "uuid" },
          "credential_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "activated_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        }
      },
      "CredentialMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "credential_id",
          "credential_version",
          "state",
          "issued_at",
          "activated_at",
          "expires_at",
          "revoked_at",
          "revocation_reason"
        ],
        "properties": {
          "schema_version": { "type": "string", "const": "1.0.0" },
          "credential_id": { "type": "string", "format": "uuid" },
          "credential_version": { "type": "integer", "minimum": 1 },
          "state": {
            "type": "string",
            "enum": ["pending", "active", "revoked", "expired"]
          },
          "issued_at": { "type": "string", "format": "date-time" },
          "activated_at": {
            "anyOf": [
              { "type": "string", "format": "date-time" },
              { "type": "null" }
            ]
          },
          "expires_at": { "type": "string", "format": "date-time" },
          "revoked_at": {
            "anyOf": [
              { "type": "string", "format": "date-time" },
              { "type": "null" }
            ]
          },
          "revocation_reason": {
            "anyOf": [
              { "type": "string", "minLength": 1, "maxLength": 128 },
              { "type": "null" }
            ]
          }
        }
      },
      "ManifestAccepted": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "manifest_id",
          "manifest_digest",
          "server_received_at"
        ],
        "properties": {
          "schema_version": { "type": "string", "const": "1.0.0" },
          "manifest_id": { "type": "string", "format": "uuid" },
          "manifest_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "server_received_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        }
      },
      "PresenceResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "accepted_sequence",
          "server_received_at",
          "presence_expires_at",
          "poll_after_seconds"
        ],
        "properties": {
          "schema_version": { "type": "string", "const": "1.0.0" },
          "accepted_sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "server_received_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "presence_expires_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "poll_after_seconds": {
            "type": "integer",
            "minimum": 15,
            "maximum": 900
          }
        }
      }
    },
    "requestBodies": {
      "EnrollmentTokenCreate": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/EnrollmentTokenCreateRequest" }
          }
        }
      },
      "RotationCreate": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/RotationRequest" }
          }
        }
      },
      "RotationActivate": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/RotationRequest" }
          }
        }
      },
      "GenericJson": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "type": "object", "maxProperties": 32 }
          }
        }
      }
    },
    "responses": {
      "EnrollmentTokenCreated": {
        "description": "Enrollment secret returned once logically",
        "headers": {
          "X-Correlation-ID": { "$ref": "#/components/headers/CorrelationId" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/EnrollmentTokenResponse" }
          }
        }
      },
      "CredentialMetadataList": {
        "description": "Credential versions without secrets",
        "headers": {
          "X-Correlation-ID": { "$ref": "#/components/headers/CorrelationId" }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "maxItems": 128,
              "items": { "$ref": "#/components/schemas/CredentialMetadata" }
            }
          }
        }
      },
      "RotationCreated": {
        "description": "Pending credential returned once logically",
        "headers": {
          "X-Correlation-ID": { "$ref": "#/components/headers/CorrelationId" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/RotationCreateResponse" }
          }
        }
      },
      "RotationActivated": {
        "description": "Pending credential activated",
        "headers": {
          "X-Correlation-ID": { "$ref": "#/components/headers/CorrelationId" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/RotationActivateResponse" }
          }
        }
      },
      "ManifestAccepted": {
        "description": "Capability manifest accepted",
        "headers": {
          "X-Correlation-ID": { "$ref": "#/components/headers/CorrelationId" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ManifestAccepted" }
          }
        }
      },
      "PresenceAccepted": {
        "description": "Heartbeat or mobile presence accepted",
        "headers": {
          "X-Correlation-ID": { "$ref": "#/components/headers/CorrelationId" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/PresenceResponse" }
          }
        }
      },
      "JsonSuccess": {
        "description": "Successful JSON response",
        "headers": {
          "X-Correlation-ID": { "$ref": "#/components/headers/CorrelationId" }
        },
        "content": { "application/json": { "schema": { "type": "object" } } }
      },
      "Error": {
        "description": "Normative error",
        "headers": {
          "X-Correlation-ID": { "$ref": "#/components/headers/CorrelationId" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "../schemas/error-envelope.schema.json" }
          }
        }
      }
    }
  }
}
