# Normalize text files
* text=auto

# Cross-platform source files
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini  text eol=lf

*.py   text eol=lf
*.sh   text eol=lf

*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf

*.kt   text eol=lf
*.kts  text eol=lf
*.java text eol=lf
*.swift text eol=lf

# Windows-native scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary documentation
*.pdf  binary
*.docx binary
*.zip  binary

# Images
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary

# Network captures
*.pcap   binary
*.pcapng binary

# Repository control and extensionless files
.gitattributes text eol=lf
.gitignore     text eol=lf
.dockerignore  text eol=lf
.env.example   text eol=lf
Dockerfile     text eol=lf
Makefile       text eol=lf
*.conf         text eol=lf
*.lock         text eol=lf
*.mmd          text eol=lf
*.mako          text eol=lf
.prettierignore text eol=lf
