{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.wifi-test-orchestrator.example/1.0.0/error-envelope.schema.json",
  "title": "ErrorEnvelope",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "error"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "details", "correlation_id"],
      "properties": {
        "code": {"type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]+$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 256},
        "details": {"anyOf": [{"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["location", "type"], "properties": {"location": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 64}}, "type": {"type": "string", "maxLength": 64}}}}, {"type": "null"}]},
        "correlation_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
      }
    }
  }
}
