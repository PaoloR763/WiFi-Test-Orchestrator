{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.wifi-test-orchestrator.example/1.0.0/agent-credential.schema.json",
  "title": "AgentCredential",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "credential_id", "credential_version", "credential", "issued_at", "expires_at", "state"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "credential_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "credential_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "credential": {"type": "string", "minLength": 89, "maxLength": 89, "pattern": "^wto_ac_1\\.[0-9a-f-]{36}\\.[A-Za-z0-9_-]{43}$"},
    "issued_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
    "expires_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
    "state": {"type": "string", "enum": ["active", "pending"]}
  }
}
