{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.wifi-test-orchestrator.example/1.0.0/capability-manifest.schema.json",
  "title": "CapabilityManifest",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "manifest_sequence", "agent_id", "agent_version", "platform", "platform_version", "protocol_version", "capability_catalog_version", "generated_at", "capabilities"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "manifest_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "manifest_sequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "agent_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "agent_version": {"$ref": "common.schema.json#/$defs/semver"},
    "platform": {"$ref": "common.schema.json#/$defs/platform"},
    "platform_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "protocol_version": {"$ref": "common.schema.json#/$defs/agent_protocol"},
    "capability_catalog_version": {"type": "string", "const": "1.0.0"},
    "generated_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
    "capabilities": {
      "type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true,
      "items": {"$ref": "#/$defs/capability"},
      "allOf": [
        {"contains": {"type": "object", "properties": {"id": {"const": "wifi.connection.read"}}, "required": ["id"]}},
        {"contains": {"type": "object", "properties": {"id": {"const": "wifi.scan"}}, "required": ["id"]}},
        {"contains": {"type": "object", "properties": {"id": {"const": "wifi.rssi.read"}}, "required": ["id"]}},
        {"contains": {"type": "object", "properties": {"id": {"const": "network.icmp.ping"}}, "required": ["id"]}},
        {"contains": {"type": "object", "properties": {"id": {"const": "network.tcp.probe"}}, "required": ["id"]}},
        {"contains": {"type": "object", "properties": {"id": {"const": "network.http.probe"}}, "required": ["id"]}},
        {"contains": {"type": "object", "properties": {"id": {"const": "traffic.tcp.throughput"}}, "required": ["id"]}},
        {"contains": {"type": "object", "properties": {"id": {"const": "traffic.udp.throughput"}}, "required": ["id"]}},
        {"contains": {"type": "object", "properties": {"id": {"const": "traffic.http.download"}}, "required": ["id"]}},
        {"contains": {"type": "object", "properties": {"id": {"const": "traffic.http.upload"}}, "required": ["id"]}},
        {"contains": {"type": "object", "properties": {"id": {"const": "traffic.latency_under_load"}}, "required": ["id"]}},
        {"contains": {"type": "object", "properties": {"id": {"const": "capture.ip"}}, "required": ["id"]}},
        {"contains": {"type": "object", "properties": {"id": {"const": "capture.ieee80211.monitor"}}, "required": ["id"]}},
        {"contains": {"type": "object", "properties": {"id": {"const": "traffic.pcap.replay"}}, "required": ["id"]}},
        {"contains": {"type": "object", "properties": {"id": {"const": "execution.background.continuous"}}, "required": ["id"]}}
      ]
    }
  },
  "$defs": {
    "reason_nullable": {"anyOf": [{"$ref": "reason.schema.json"}, {"type": "null"}]},
    "dimension_reason": {"type": "object", "additionalProperties": false, "properties": {"reason": {"$ref": "#/$defs/reason_nullable"}}},
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "technical_support", "implementation_status", "permission_requirement", "user_interaction", "background_execution", "provider", "limitations"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/capability_id"},
        "version": {"type": "string", "const": "1.0.0"},
        "technical_support": {"$ref": "#/$defs/technical_support"},
        "implementation_status": {"$ref": "#/$defs/implementation_status"},
        "permission_requirement": {"$ref": "#/$defs/permission_requirement"},
        "user_interaction": {"$ref": "#/$defs/user_interaction"},
        "background_execution": {"$ref": "#/$defs/background_execution"},
        "provider": {"$ref": "#/$defs/provider"},
        "limitations": {"$ref": "#/$defs/limitations"}
      }
    },
    "technical_support": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"type": "string", "enum": ["supported", "conditional", "unsupported", "unknown", "not_applicable"]}, "reason": {"$ref": "#/$defs/reason_nullable"}}},
    "implementation_status": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"type": "string", "enum": ["implemented", "partial", "planned", "not_implemented", "excluded", "unknown"]}, "reason": {"$ref": "#/$defs/reason_nullable"}}},
    "permission_requirement": {"type": "object", "additionalProperties": false, "required": ["status", "permissions", "reason"], "properties": {"status": {"type": "string", "enum": ["none", "required", "conditional", "denied", "restricted", "unknown", "not_applicable"]}, "permissions": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9._-]+$"}}, "reason": {"$ref": "#/$defs/reason_nullable"}}},
    "user_interaction": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"type": "string", "enum": ["none", "required", "conditional", "unknown", "not_applicable"]}, "reason": {"$ref": "#/$defs/reason_nullable"}}},
    "background_execution": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"type": "string", "enum": ["continuous", "bounded", "foreground_only", "deferred", "not_supported", "unknown", "not_applicable"]}, "reason": {"$ref": "#/$defs/reason_nullable"}}},
    "provider": {
      "type": "object", "additionalProperties": false, "required": ["status", "implementations", "reason"],
      "properties": {
        "status": {"type": "string", "enum": ["available", "unavailable", "unknown", "not_applicable"]},
        "implementations": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["provider_id", "provider_version", "method"], "properties": {"provider_id": {"type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[a-z][a-z0-9.-]+$"}, "provider_version": {"$ref": "common.schema.json#/$defs/semver"}, "method": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$"}}}},
        "reason": {"$ref": "#/$defs/reason_nullable"}
      }
    },
    "limitations": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"type": "string", "enum": ["known", "unknown", "not_applicable"]}, "max_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}, "max_throughput_bps": {"type": "integer", "minimum": 1, "maximum": 1000000000000}, "max_payload_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824}, "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 1024}, "max_streams": {"type": "integer", "minimum": 1, "maximum": 128}, "reason": {"$ref": "#/$defs/reason_nullable"}}}
  }
}
